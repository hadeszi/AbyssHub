local function ApplyTheme(themeName)
    local t = Themes[themeName] or Themes["Royal Purple"]
    Theme = t
    Config.CurrentTheme = themeName

    for _, frame in ipairs(ThemeElements.MainFrames) do pcall(function() frame.BackgroundColor3 = t.MainBg end) end
    for _, frame in ipairs(ThemeElements.Sidebars) do pcall(function() frame.BackgroundColor3 = t.SidebarBg end) end
    for _, card in ipairs(ThemeElements.Cards) do pcall(function() card.BackgroundColor3 = t.CardBg end) end
    for _, stroke in ipairs(ThemeElements.Strokes) do pcall(function() stroke.Color = t.CardStroke end) end
    for _, accent in ipairs(ThemeElements.Accents) do
        pcall(function()
            if accent:IsA("UIStroke") then
                accent.Color = t.Accent
            elseif accent:IsA("TextLabel") or accent:IsA("TextButton") or accent:IsA("TextBox") then
                accent.TextColor3 = t.Accent
            elseif accent:IsA("Frame") or accent:IsA("ScrollingFrame") then
                accent.BackgroundColor3 = t.Accent
            end
        end)
    end
    for _, grad in ipairs(ThemeElements.AccentGradients) do pcall(function() grad.Color = t.AccentGradient end) end
    for _, lbl in ipairs(ThemeElements.TextPrimaries) do pcall(function() lbl.TextColor3 = t.TextPrimary end) end
    for _, lbl in ipairs(ThemeElements.TextSecondaries) do pcall(function() lbl.TextColor3 = t.TextSecondary end) end
    for _, inp in ipairs(ThemeElements.Inputs) do pcall(function() inp.BackgroundColor3 = t.InputBg end) end
    for _, tog in ipairs(ThemeElements.Toggles) do
        pcall(function()
            if tog.GetState and tog.GetState() then
                tog.Switch.BackgroundColor3 = t.ToggleOn
            else
                tog.Switch.BackgroundColor3 = t.ToggleOff
            end
        end)
    end
    for _, fn in ipairs(ThemeElements.DropdownUpdaters) do pcall(fn) end

    if ActiveNavButton then
        pcall(function()
            ActiveNavButton.BackgroundColor3 = t.CardBg
            ActiveNavButton.TextColor3 = t.TextPrimary
        end)
    end
    if DynamicNavButtons then
        for _, btnData in ipairs(DynamicNavButtons) do
            if btnData.Button ~= ActiveNavButton then
                pcall(function() btnData.Button.TextColor3 = t.TextSecondary end)
            end
        end
    end
    SaveConfig()
end

