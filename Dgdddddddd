local currentWarpTween = nil

local function StopMovement()
    if currentWarpTween then
        pcall(function() currentWarpTween:Cancel() end)
        currentWarpTween = nil
    end
    local char = GetCharacter()
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.PlatformStand = false
    end
    local hrp = GetRootPart()
    if hrp then
        local bv = hrp:FindFirstChild("AntiHubFloat")
        if bv then bv:Destroy() end
    end
end

local function MoveToTarget(targetCF)
    if not Config.AutoFarmMobs and not Config.AutoChests then return end
    local hrp = GetRootPart()
    local char = GetCharacter()
    if not hrp or not char then return end
    
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    
    if Config.WarpMode == "Tween" then
        local dist = (hrp.Position - targetCF.Position).Magnitude
        local speed = math.clamp(Config.TweenSpeed or 120, 30, 500)
        local duration = math.clamp(dist / speed, 0.05, 3)
        
        if currentWarpTween then
            pcall(function() currentWarpTween:Cancel() end)
            currentWarpTween = nil
        end
        
        currentWarpTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCF})
        currentWarpTween:Play()
    else
        if currentWarpTween then
            pcall(function() currentWarpTween:Cancel() end)
            currentWarpTween = nil
        end
        hrp.CFrame = targetCF
    end
end

local function AttackWeapon(targetHRP)
    if not Config.AutoFarmMobs then return end
    local char = GetCharacter()
    if not char then return end
    
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if targetHRP and myHRP then
        myHRP.CFrame = CFrame.lookAt(myHRP.Position, targetHRP.Position)
    end
    
    local weapon = nil
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") and child:FindFirstChild("Weapon") then
            weapon = child
            local rem = child:FindFirstChildOfClass("RemoteEvent")
            if rem then pcall(function() rem:FireServer() end) end
        end
    end
    
    local weaponUsed = ReplicatedStorage:FindFirstChild("remotes") and ReplicatedStorage.remotes:FindFirstChild("weaponUsed")
    if weaponUsed then
        pcall(function() weaponUsed:FireServer() end)
    end
    
    if weapon and targetHRP and firetouchinterest then
        local hb = weapon:FindFirstChild("hitBox")
        if hb then
            pcall(function()
                firetouchinterest(targetHRP, hb, 0)
                task.wait(0.01)
                firetouchinterest(targetHRP, hb, 1)
            end)
        end
    end
end

local function CastAbilities(targetHRP)
    if not Config.AutoFarmMobs or not Config.AutoAbilities then return end
    local char = GetCharacter()
    if not char then return end
    
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if targetHRP and myHRP then
        myHRP.CFrame = CFrame.lookAt(myHRP.Position, targetHRP.Position)
    end
    
    local lp = GetPlayer()
    local backpack = lp and lp:FindFirstChild("Backpack")
    local abilityUsed = ReplicatedStorage:FindFirstChild("remotes") and ReplicatedStorage.remotes:FindFirstChild("abilityUsed")
    
    local function CastSlot(tool, slotName)
        if not tool then return end
        local cd = tool:FindFirstChild("cooldown")
        if not cd or cd.Value <= 0 then
            local localEv = tool:FindFirstChild("localEvent")
            if localEv then pcall(function() localEv:Fire() end) end
            
            if abilityUsed then pcall(function() abilityUsed:FireServer(slotName, tool) end) end
            
            for _, r in ipairs(tool:GetChildren()) do
                if r:IsA("RemoteEvent") then
                    pcall(function() r:FireServer() end)
                end
            end
        end
    end
    
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool:FindFirstChild("abilitySlot") then
                CastSlot(tool, tool.abilitySlot.Value)
            end
        end
    end
    
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("abilitySlot") then
            CastSlot(tool, tool.abilitySlot.Value)
        end
    end
end

