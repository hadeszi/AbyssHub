-- Safe GUI Parent Selector
local function GetSafeGuiParent()
    local parent = nil
    pcall(function()
        if gethui then parent = gethui() end
    end)
    if parent then return parent end

    pcall(function()
        if syn and syn.protect_gui then
            syn.protect_gui(CoreGui)
            parent = CoreGui
        end
    end)
    if parent then return parent end

    pcall(function()
        local robloxGui = CoreGui:FindFirstChild("RobloxGui")
        if robloxGui then parent = robloxGui end
    end)
    if parent then return parent end

    if CoreGui then
        local ok = pcall(function()
            local test = Instance.new("Folder")
            test.Parent = CoreGui
            test:Destroy()
        end)
        if ok then return CoreGui end
    end

    local lp = GetPlayer()
    return lp and lp:WaitForChild("PlayerGui", 10)
end

local ScreenParent = GetSafeGuiParent()

local function CleanAllExistingUIs()
    local lp = GetPlayer()
    local targets = {CoreGui, CoreGui:FindFirstChild("RobloxGui"), lp and lp:FindFirstChild("PlayerGui")}
    if gethui then pcall(function() table.insert(targets, gethui()) end) end
    for _, parent in ipairs(targets) do
        if parent then
            for _, child in ipairs(parent:GetChildren()) do
                if child.Name == "AntiHub_DQReborn_UI" or child.Name == "AntiHub_Template_UI" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
end
CleanAllExistingUIs()

