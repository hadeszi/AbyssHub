local LOBBY_PLACE_ID = 77649408247578

local function IsInLobby()
    if game.PlaceId == LOBBY_PLACE_ID then
        return true
    end
    if Workspace:FindFirstChild("Lobby") ~= nil then
        return true
    end
    local ok, pm = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Utility"):WaitForChild("PlaceManager"))
    end)
    if ok and pm and pm.IsLobby then
        return pm.IsLobby()
    end
    if ok and pm and pm.GetPlaceName then
        return pm.GetPlaceName() == "Lobby" or pm.GetPlaceName() == "100+"
    end
    return false
end

local function IsInDungeon()
    return not IsInLobby()
end

local function IsDungeonFinished()
    local progress = Workspace:FindFirstChild("dungeonProgress")
    if progress and progress:IsA("StringValue") then
        if progress.Value == "completed" or progress.Value == "failed" then
            return true
        end
    end
    local bossRoom = Workspace:FindFirstChild("dungeon") and Workspace.dungeon:FindFirstChild("bossRoom")
    if bossRoom and bossRoom:FindFirstChild("dungeonFinished") and bossRoom.dungeonFinished.Value == true then
        return true
    end
    local lp = GetPlayer()
    if lp and lp:FindFirstChild("PlayerGui") then
        if lp.PlayerGui:FindFirstChild("completeGui") ~= nil or lp.PlayerGui:FindFirstChild("failedGui") ~= nil then
            return true
        end
    end
    return false
end

local function StartDungeonIfWaiting()
    if not Config.AutoStartDungeon then return end
    pcall(function()
        local readyUp = ReplicatedStorage:FindFirstChild("remotes") and ReplicatedStorage.remotes:FindFirstChild("readyUp")
        if readyUp then readyUp:FireServer() end
        
        local startDungeon = ReplicatedStorage:FindFirstChild("remotes") and ReplicatedStorage.remotes:FindFirstChild("startDungeon")
        if startDungeon then startDungeon:FireServer() end
        
        local lp = GetPlayer()
        local startBtn = lp and lp:FindFirstChild("PlayerGui") and lp.PlayerGui:FindFirstChild("startButton")
        if startBtn then
            for _, b in ipairs(startBtn:GetDescendants()) do
                if b:IsA("GuiButton") then
                    pcall(function()
                        for _, c in ipairs(getconnections(b.MouseButton1Click)) do c:Fire() end
                        for _, c in ipairs(getconnections(b.MouseButton1Down)) do c:Fire() end
                        for _, c in ipairs(getconnections(b.Activated)) do c:Fire() end
                    end)
                end
            end
        end
    end)
end

