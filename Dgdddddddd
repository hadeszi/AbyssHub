-- Comprehensive Dungeon Enemy Scanner
local function GetAllActiveEnemies(maxRange)
    local enemies = {}
    local myRoot = GetRootPart()
    if not myRoot then return enemies end
    
    local dungeon = Workspace:FindFirstChild("dungeon")
    if dungeon then
        for _, room in ipairs(dungeon:GetChildren()) do
            local enemyFolder = room:FindFirstChild("enemyFolder") or room:FindFirstChild("enemies")
            if enemyFolder then
                for _, mob in ipairs(enemyFolder:GetChildren()) do
                    if mob:IsA("Model") then
                        local hum = mob:FindFirstChildOfClass("Humanoid")
                        local hrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso") or mob:FindFirstChild("Head")
                        local healthVal = mob:FindFirstChild("Health")
                        
                        local isAlive = false
                        if healthVal and healthVal.Value > 0 then
                            isAlive = true
                        elseif hum and hum.Health > 0 then
                            isAlive = true
                        elseif hrp and not healthVal and not hum then
                            isAlive = true
                        end
                        
                        if isAlive and hrp then
                            local dist = (myRoot.Position - hrp.Position).Magnitude
                            if not maxRange or dist <= maxRange then
                                table.insert(enemies, {Model = mob, HRP = hrp, Hum = hum, Distance = dist, Room = room})
                            end
                        end
                    end
                end
            end
        end
    end
    
    if Workspace:FindFirstChild("enemies") then
        for _, mob in ipairs(Workspace.enemies:GetChildren()) do
            if mob:IsA("Model") then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local hrp = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso") or mob:FindFirstChild("Head")
                local healthVal = mob:FindFirstChild("Health")
                local isAlive = (healthVal and healthVal.Value > 0) or (hum and hum.Health > 0) or (hrp and not healthVal and not hum)
                if isAlive and hrp then
                    local dist = (myRoot.Position - hrp.Position).Magnitude
                    if not maxRange or dist <= maxRange then
                        table.insert(enemies, {Model = mob, HRP = hrp, Hum = hum, Distance = dist, Room = nil})
                    end
                end
            end
        end
    end
    
    table.sort(enemies, function(a, b) return a.Distance < b.Distance end)
    return enemies
end

-- Get Next Room Checkpoint / Spawn Trigger
local function GetNextRoomCheckpoint()
    local dungeon = Workspace:FindFirstChild("dungeon")
    if not dungeon then return nil end
    
    local rooms = {}
    for _, room in ipairs(dungeon:GetChildren()) do
        local order = room:FindFirstChild("order") and room.order.Value or 99
        table.insert(rooms, {room = room, order = order})
    end
    table.sort(rooms, function(a, b) return a.order < b.order end)
    
    for _, rData in ipairs(rooms) do
        local room = rData.room
        local enemyFolder = room:FindFirstChild("enemyFolder") or room:FindFirstChild("enemies")
        if enemyFolder then
            for _, child in ipairs(enemyFolder:GetChildren()) do
                if child.Name == "spawn" or child:IsA("Part") then
                    return child.Position
                end
            end
        end
        local cp = room:FindFirstChild("checkPoint") or room:FindFirstChild("startPart") or room:FindFirstChild("endPart")
        if cp and cp:IsA("BasePart") then
            return cp.Position
        end
    end
    return nil
end

