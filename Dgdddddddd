local function LoadLogoAsset()
    pcall(function()
        if isfile and isfile(LOGO_FILE) and getcustomasset then
            LogoAsset = getcustomasset(LOGO_FILE)
            return
        end
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req and writefile and getcustomasset then
            local res = req({Url = LOGO_URL, Method = "GET"})
            if res and res.Body then
                writefile(LOGO_FILE, res.Body)
                LogoAsset = getcustomasset(LOGO_FILE)
                return
            end
        end
        if game.HttpGet and writefile and getcustomasset then
            local data = game:HttpGet(LOGO_URL)
            if data and #data > 100 then
                writefile(LOGO_FILE, data)
                LogoAsset = getcustomasset(LOGO_FILE)
                return
            end
        end
    end)
end
