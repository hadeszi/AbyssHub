-- Switch Tab Helper
local function SwitchTab(targetTab, navButton)
    CloseAllDropdownsExcept(nil)
    for _, tabFrame in pairs(Tabs) do tabFrame.Visible = false end
    targetTab.Visible = true

    for _, btnData in ipairs(DynamicNavButtons) do
        TweenService:Create(btnData.Button, TweenInfo.new(0.2), {
            BackgroundColor3 = Theme.SidebarBg,
            BackgroundTransparency = 1,
            TextColor3 = Theme.TextSecondary
        }):Play()
        btnData.Indicator.Visible = false
    end

    ActiveNavButton = navButton
    TweenService:Create(navButton, TweenInfo.new(0.2), {
        BackgroundColor3 = Theme.CardBg,
        BackgroundTransparency = 0,
        TextColor3 = Theme.TextPrimary
    }):Play()

    local ind = navButton:FindFirstChild("ActiveIndicator")
    if ind then ind.Visible = true end
end

