-- 5. Main Auto Farm & Combat Loop (STRICT: 100% Isolated by individual Toggles)
local lastLobbyAttempt = 0
local lastReplayAttempt = 0
local currentDungeonTierAtStart = nil

RegisterThread(task.spawn(function()
    while task.wait(0.05) do
        pcall(function()
            local inLobby = IsInLobby()
            local hrp = GetRootPart()
            local char = GetCharacter()
            
            -- ==========================================================
            -- CASE A: INSIDE A DUNGEON
            -- ==========================================================
            if not inLobby and hrp and char then
                -- 1. Auto Start Check (STRICT: Only if AutoStartDungeon is true)
                if Config.AutoStartDungeon then
                    StartDungeonIfWaiting()
                end
                
                local isFinished = IsDungeonFinished()
                
                -- 2. Check for Chests / Loot (STRICT: Only if AutoChests is true)
                if Config.AutoChests then
                    local chestFolder = Workspace:FindFirstChild("chestFolder")
                    if chestFolder then
                        for _, chest in ipairs(chestFolder:GetChildren()) do
                            local part = chest:FindFirstChild("Part") or chest:FindFirstChild("Root") or (chest:IsA("BasePart") and chest)
                            if part then
                                MoveToTarget(part.CFrame * CFrame.new(0, 2, 0))
                                task.wait(0.2)
                            end
                        end
                    end
                end
                
                -- 3. Check if Dungeon is Completed / Finished
                if isFinished then
                    StopMovement()
                    
                    if (Config.AutoDungeon or Config.AutoBestDungeon) and Config.AutoReplay then
                        local now = tick()
                        if now - lastReplayAttempt > 12 then
                            lastReplayAttempt = now
                            task.wait(5)
                            
                            local lp = GetPlayer()
                            local pLevel = lp and lp:FindFirstChild("leaderstats") and lp.leaderstats:FindFirstChild("Level") and lp.leaderstats.Level.Value or 1
                            local bestD, bestDiff, bestReq = GetBestDungeonForLevel(pLevel)
                            
                            if Config.AutoBestDungeon and currentDungeonTierAtStart and (bestD ~= currentDungeonTierAtStart.Dungeon or bestDiff ~= currentDungeonTierAtStart.Difficulty) then
                                local teleToLobby = ReplicatedStorage.remotes:FindFirstChild("teleToLobby") or ReplicatedStorage.remotes:FindFirstChild("ReturnToLobbyEvent")
                                if teleToLobby then
                                    teleToLobby:FireServer()
                                else
                                    local replayDungeon = ReplicatedStorage.remotes:FindFirstChild("replayDungeon")
                                    if replayDungeon then replayDungeon:FireServer() end
                                end
                            else
                                local replayDungeon = ReplicatedStorage.remotes:FindFirstChild("replayDungeon")
                                if replayDungeon then
                                    replayDungeon:FireServer()
                                end
                            end
                        end
                    end
                else
                    -- Dungeon in progress
                    if not currentDungeonTierAtStart then
                        local lp = GetPlayer()
                        local pLevel = lp and lp:FindFirstChild("leaderstats") and lp.leaderstats:FindFirstChild("Level") and lp.leaderstats.Level.Value or 1
                        local bD, bDiff = GetBestDungeonForLevel(pLevel)
                        currentDungeonTierAtStart = {Dungeon = bD, Difficulty = bDiff}
                    end
                    
                    -- 4. Auto Farm Mobs (STRICT: ONLY executes when Config.AutoFarmMobs == true)
                    if Config.AutoFarmMobs then
                        local enemies = GetAllActiveEnemies()
                        if #enemies > 0 then
                            local target = enemies[1]
                            if target and target.HRP and target.HRP.Parent then
                                local tHRP = target.HRP
                                local dist = math.clamp(tonumber(Config.FarmDistance) or 3, 0.5, 50)
                                local targetCF
                                
                                if Config.FarmPosition == "Behind" then
                                    local backPos = tHRP.Position + (tHRP.CFrame.LookVector * -dist)
                                    if Config.LockYAxis then
                                        targetCF = CFrame.lookAt(Vector3.new(backPos.X, tHRP.Position.Y + 1.2, backPos.Z), tHRP.Position)
                                    else
                                        targetCF = CFrame.lookAt(backPos + Vector3.new(0, 1.2, 0), tHRP.Position)
                                    end
                                elseif Config.FarmPosition == "Front" then
                                    local frontPos = tHRP.Position + (tHRP.CFrame.LookVector * dist)
                                    if Config.LockYAxis then
                                        targetCF = CFrame.lookAt(Vector3.new(frontPos.X, tHRP.Position.Y + 1.2, frontPos.Z), tHRP.Position)
                                    else
                                        targetCF = CFrame.lookAt(frontPos + Vector3.new(0, 1.2, 0), tHRP.Position)
                                    end
                                elseif Config.FarmPosition == "Above" then
                                    targetCF = CFrame.lookAt(tHRP.Position + Vector3.new(0, dist + 1.5, 0), tHRP.Position)
                                elseif Config.FarmPosition == "Below" then
                                    targetCF = CFrame.lookAt(tHRP.Position - Vector3.new(0, dist + 1.5, 0), tHRP.Position)
                                end
                                
                                if char:FindFirstChild("Humanoid") then
                                    char.Humanoid.PlatformStand = true
                                end
                                
                                MoveToTarget(targetCF)
                                
                                local bv = hrp:FindFirstChild("AntiHubFloat")
                                if not bv then
                                    bv = Instance.new("BodyVelocity")
                                    bv.Name = "AntiHubFloat"
                                    bv.Velocity = Vector3.new(0, 0, 0)
                                    bv.MaxForce = Vector3.new(400000, 400000, 400000)
                                    bv.Parent = hrp
                                end
                                
                                AttackWeapon(tHRP)
                                if Config.FastAttack then
                                    AttackWeapon(tHRP)
                                end
                                if Config.AutoAbilities then
                                    CastAbilities(tHRP)
                                end
                            end
                        else
                            -- No active mobs in room: Move to next room spawn point only if AutoFarmMobs is active
                            if char:FindFirstChild("Humanoid") then char.Humanoid.PlatformStand = false end
                            local nextPos = GetNextRoomCheckpoint()
                            if nextPos then
                                MoveToTarget(CFrame.new(nextPos + Vector3.new(0, 3, 0)))
                            end
                            local bv = hrp:FindFirstChild("AntiHubFloat")
                            if bv then bv:Destroy() end
                        end
                    else
                        StopMovement()
                    end
                end
            
            -- ==========================================================
            -- CASE B: IN MAIN LOBBY
            -- ==========================================================
            elseif inLobby then
                currentDungeonTierAtStart = nil
                StopMovement()
                
                if Config.AutoDungeon or Config.AutoBestDungeon then
                    local now = tick()
                    if now - lastLobbyAttempt > 8 then
                        local lp = GetPlayer()
                        local inGame = lp and lp:FindFirstChild("inGame") and lp.inGame.Value or false
                        local isTeleporting = lp and lp:FindFirstChild("teleporting") and lp.teleporting.Value or false
                        
                        if not inGame and not isTeleporting then
                            lastLobbyAttempt = now
                            local createLobby = ReplicatedStorage.remotes:FindFirstChild("createLobby")
                            local startDungeon = ReplicatedStorage.remotes:FindFirstChild("startDungeon")
                            if createLobby and startDungeon then
                                local pLevel = lp and lp:FindFirstChild("leaderstats") and lp.leaderstats:FindFirstChild("Level") and lp.leaderstats.Level.Value or 1
                                local targetDungeon, targetDifficulty
                                
                                if Config.AutoBestDungeon then
                                    targetDungeon, targetDifficulty = GetBestDungeonForLevel(pLevel)
                                else
                                    targetDungeon = Config.SelectedDungeon:gsub("%s+%[.+%]", "")
                                    targetDifficulty = Config.SelectedDifficulty
                                end
                                
                                local ok = createLobby:InvokeServer(targetDungeon, targetDifficulty, 0, Config.IsHardcore, false, Config.IsWaveDefense)
                                if ok then
                                    task.wait(1.5)
                                    startDungeon:FireServer()
                                else
                                    local okEasy = createLobby:InvokeServer(targetDungeon, "Easy", 0, false, false, false)
                                    if okEasy then
                                        task.wait(1.5)
                                        startDungeon:FireServer()
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end))

